class Solution:
    def climbStairs(self, n: int, costs: List[int]) -> int:
        
        dp = [float('inf')] * (n + 1)
        dp[0] = 0
        
        # Iterate through each step from 1 to n
        for i in range(1, n + 1):
            # costs is 1-indexed in the problem, so step i uses costs[i - 1]
            current_step_cost = costs[i - 1]
            
            # Look back up to 3 steps
            for j in range(max(0, i - 3), i):
                jump_cost = (i - j) ** 2
                dp[i] = min(dp[i], dp[j] + current_step_cost + jump_cost)
                
        return dp[n]
        
