class Solution:
    def minimumChanges(self, s: str, k: int) -> int:
        
        n = len(s)
        INF = 10**9

        # Step 1: Precompute minimum changes for every substring
        cost = [[INF] * n for _ in range(n)]

        for length in range(2, n + 1):
            for i in range(n - length + 1):
                for d in range(1, length):
                    if length % d != 0:
                        continue

                    changes = 0
                    groups = length // d

                    for r in range(d):
                        for p in range(groups // 2):
                            left = i + r + p * d
                            right = i + r + (groups - 1 - p) * d

                            if s[left] != s[right]:
                                changes += 1

                    cost[i][i + length - 1] = min(
                        cost[i][i + length - 1], changes
                    )

        # Step 2: Dynamic Programming
        dp = [[INF] * (n + 1) for _ in range(k + 1)]
        dp[0][0] = 0

        for parts in range(1, k + 1):
            for end in range(2 * parts, n + 1):
                for start in range(2 * (parts - 1), end - 1):
                    dp[parts][end] = min(
                        dp[parts][end],
                        dp[parts - 1][start] + cost[start][end - 1]
                    )

        return dp[k][n]
